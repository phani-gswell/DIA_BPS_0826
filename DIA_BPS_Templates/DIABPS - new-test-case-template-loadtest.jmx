              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import jmeter.appian.groundswell.*
import jmeter.appian.groundswell.sailcontrols.MultipleFileUploadWidget

try{
	def JAG = new Jag2(log,vars,prev.getResponseDataAsString()); 

	def fuCoverImage = vars.getObject(&quot;fuCoverImage&quot;) as MultipleFileUploadWidget
	fuCoverImage.parseUploadResponse(prev.getResponseDataAsString())

	JAG.saveSail(fuCoverImage)
	
}catch(e){
	log.error(&quot;Error in Upload Cover Image: ${e.message}&quot;)
}
</stringProp>
            </JSR223PostProcessor>
