              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2
import jmeter.appian.groundswell.sailcontrols.PeoplePicker


try{

	def JAG = new Jag2(log,vars,prev.getResponseDataAsString()); 
	JAG.setSailContextAndUuid(); 
	
	def pickerWhoRecommended = new PeoplePicker(
		JAG.getObjectByProperty(&quot;testLabel&quot;,&quot;test-Who recommended this movie to you?&quot;),
		&quot;pickerWhoRecommended&quot;,
		vars.get(&quot;pickerWhoRecommended_previous&quot;)		
	)

	JAG.saveSail(pickerWhoRecommended)
	
}catch(e)
{
	log.error(&quot;Error:${e.message}&quot;)
}</stringProp>
            </JSR223PostProcessor>
