                <stringProp name="script">import jmeter.appian.groundswell.*
import jmeter.appian.groundswell.sailcontrols.MultipleFileUploadWidget

try{
	def JAG = new Jag2(log,vars,prev.getResponseDataAsString()); 

	//Get the saved Supporting Docs MultipleFileUploadWidget 
	def fuSupportingDocs = vars.getObject(&quot;fuSupportingDocs&quot;) as MultipleFileUploadWidget

	//Parse and process the file upload validation response	
	fuSupportingDocs.parseUploadResponse(prev.getResponseDataAsString())

	JAG.saveSail(fuSupportingDocs)
}catch(e){
	log.error(&quot;Error in Upload Supporting Docs 1: ${e.message}&quot;)
}

</stringProp>
