            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - txbFilmName, txbGrammyAwards, ddGenre, pickerWhoRecommended" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2


try{
	def JAG = new Jag2(log,vars,prev.getResponseDataAsString()); 
	JAG.setSailContextAndUuid(); 
	JAG.saveOpaqueTaskID(); 
			
	
	def txbFilmName = 	JAG.createControl(
		JAG.getObjectByProperty(&quot;label&quot;,&quot;Film Name&quot;),
		&quot;txbFilmName&quot;
	)?.enterValue(vars.get(&quot;movieName&quot;))

	def txbGrammyAwards = 	JAG.createControl(
		JAG.getObjectByProperty(&quot;label&quot;,&quot;Grammy Awards&quot;),
		&quot;txbGrammyAwards&quot;
	)?.enterValue(JAG.getRandomIntInRange(0,4).toString())


	def ddGenre = 	JAG.createControl(
		JAG.getObjectByProperty(&quot;label&quot;,&quot;Genre&quot;),
		&quot;ddGenre&quot;
	)?.selectRandomChoice()
	

	def pickerWhoRecommended = JAG.createControl(
		JAG.getObjectByProperty(&quot;testLabel&quot;,&quot;test-Who recommended this movie to you?&quot;),
		&quot;pickerWhoRecommended&quot;
	)?.enterValue(&quot;pbt.man&quot;)	

	
	
	JAG.saveSail(
		[
			txbFilmName,
			txbGrammyAwards,
			ddGenre,
			pickerWhoRecommended
		]
	)
	
	vars.putObject(&quot;pickerWhoRecommended&quot;,pickerWhoRecommended); 
	
}catch(e)
{
	log.error(&quot;Error:${e.message}&quot;); 
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
