            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor -  txbDescription, rbRecommend, dpReleaseDate, cgMovieRating, fuCoverImage" enabled="false">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.*
import java.time.LocalDate
import jmeter.appian.groundswell.Jag2

try{

def JAG = new Jag2(log,vars,prev.getResponseDataAsString()); 
JAG.setSailContextAndUuid(); 


def txbDescription = JAG.getObjectByLabel(&quot;Description&quot;);
JAG.setSaveIntoAndCId(txbDescription,&quot;txbDescription&quot;);
vars.put(&quot;txbDescription_value&quot;, &quot;Movie Description&quot;); 



def rbRecommend = JAG.createControl(
	JAG.getObjectByLabel(&quot;Would you personally reccommend?&quot;), //Get Radio Button json object
	&quot;rbRecommend&quot; // variable name prefix used 
).selectRandomChoice()

def fromDate = LocalDate.of(1980,1,1)
def toDate = LocalDate.now()

def dpReleaseDate = JAG.createControl(
	JAG.getObjectByLabel(&quot;Release Date&quot;), //Get Radio Button json object
	&quot;dpReleaseDate&quot; // variable name prefix used 
).selectRandomDate(fromDate,toDate)


def cgMovieRating = JAG.getObjectByProperty(&quot;testLabel&quot;,&quot;cardChoiceField-Movie Rating&quot;);
JAG.setSaveIntoAndCId(cgMovieRating,&quot;cgMovieRating&quot;);


def choices = cgMovieRating.identifiers.collect({it[&apos;#v&apos;]})

Collections.shuffle(choices)

vars.put(&quot;cgMovieRating_cards&quot;, JsonOutput.toJson(cgMovieRating.cards)); 
vars.put(&quot;cgMovieRating_identifiers&quot;, JsonOutput.toJson(cgMovieRating.identifiers)); 
vars.put(&quot;cgMovieRating_value&quot;, choices.first()); 


def fuCoverImage = JAG.getObjectsByType(&quot;MultipleFileUploadWidget&quot;).find({it.label == &quot;Upload Cover Image&quot;})
JAG.setSaveIntoAndCId(fuCoverImage,&quot;fuCoverImage&quot;)






JAG.saveSail([
	rbRecommend,
	dpReleaseDate
])



	 
	
}catch(e){
	log.error(e.message);
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor -  txbDescription, rbRecommend, dpReleaseDate, cgMovieRating, fuCoverImage" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.*
import java.time.LocalDate
import jmeter.appian.groundswell.Jag2

try{
	

// MAP to hold all of the extractors 
//Key = extractorName
//Value = Closure that performs the actual extraction 
def extractions = [
	&quot;txbDescription&quot; : null,
	&quot;txbTagline&quot; : null,
	&quot;rbRecommend&quot; : null,
	&quot;dpReleaseDate&quot; : null,
	&quot;cgMovieRating&quot; : null,
	&quot;fuCoverImage&quot; : null,
	&quot;pwProducer&quot; : null
]

def JAG = new Jag2(log,vars,prev.getResponseDataAsString()); 
JAG.setSailContextAndUuid(); 

//Dereference PickerObject to free up memory
vars.putObject(&quot;pickerWhoRecommended&quot;,null)

if(JAG.getData()?.ui?.modifiedComponents?.isEmpty())
	log.info(&quot;We should be failing this transaction because no item was found!&quot;)

	
extractions.txbDescription =  { 
	def description = vars.get(&quot;description&quot;);

	//Shorten to 950 chars if longer
	description = description.length() &gt; 950 ? description.substring(0,950) : description

	
	JAG.createControl(
		JAG.getObjectByLabel(&quot;Description&quot;)?.contents,
		&quot;txbDescription&quot; 
	).enterValue(description)

	
}

extractions.txbTagline = {
	JAG.createControl(
		JAG.getObjectByLabel(&quot;Tagline&quot;),
		&quot;txbTagline&quot; 
	).enterValue(&quot;Witty Tagline Goes Here&quot;)
}



extractions.rbRecommend = {
	
	JAG.createControl(
		JAG.getObjectByLabel(&quot;Would you personally reccommend?&quot;), //Get Radio Button json object
		&quot;rbRecommend&quot; // variable name prefix used 
	).selectRandomChoice()
}




extractions.dpReleaseDate = { 
	
	def fromDate = LocalDate.of(1980,1,1)
	def toDate = LocalDate.now()
	
	JAG.createControl(
		JAG.getObjectByLabel(&quot;Release Date&quot;), //Get Radio Button json object
		&quot;dpReleaseDate&quot; // variable name prefix used 
	).selectRandomDate(fromDate,toDate)
}

extractions.cgMovieRating = {
	JAG.createControl(
		JAG.getObjectByProperty(&quot;testLabel&quot;,&quot;cardChoiceField-Movie Rating&quot;), 
		&quot;cgMovieRating&quot;
	).selectRandomChoice()
}



extractions.fuCoverImage = 	{
	def image_dir = vars.get(&quot;images_dir&quot;)
	def imageName = &quot;comingSoon.png&quot;
	
	def result = JAG.createControl(
        JAG.getObjectsByType(&quot;MultipleFileUploadWidget&quot;).find({it.label == &quot;Upload Cover Image&quot;}),
        &quot;fuCoverImage&quot;
	).enterFilePath(image_dir+imageName)

	vars.putObject(&quot;fuCoverImage&quot;,result);
	return result
}


extractions.pwProducer = {
	
	def result = JAG.createControl(
        JAG.getObjectByProperty(&quot;testLabel&quot;,&quot;test-Producer&quot;),
        &quot;pwProducer&quot;
	).enterValue(&quot;pbt.man&quot;)
	
	vars.putObject(&quot;pwProducer&quot;, result);
	return result
}






//Used to execute all of the extractors and provide error handling with a single try catch 
extractions.each { ex -&gt; 
	try{
		//If extractor value/closure exists
		if( ex.value != null){
			def result = ex.value.call()
			JAG.saveSail(result)
		}
		
	}catch(e){
		log.warn(&quot;Error in extractor for ${ex.key}: ${e.message}&quot;)
	}	 
}

//
//JAG.saveSail([
//	fuCoverImage,
//	rbRecommend,
//	dpReleaseDate,
//	cgMovieRating,
//	txbDescription,
//	pwProducer,
//	txbTagline
//])



	 
	
}catch(e){
	log.error(e.message);
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
