      <hashTree/>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Thread Group - Add Movie" enabled="true">
        <stringProp name="TestPlan.comments">${AAM_USER_COUNT} ${RAMP}</stringProp>
        <stringProp name="ThreadGroup.num_threads">${USER_COUNT}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${RAMP}</stringProp>
        <stringProp name="ThreadGroup.duration">${__groovy((vars.get(&quot;RAMP&quot;).toInteger())+(vars.get(&quot;SAMPLE_PERIOD&quot;).toInteger()))}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">startnextloop</stringProp>
