            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor -  fuSupportingDocs" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2
import jmeter.appian.groundswell.sailcontrols.MultipleFileUploadWidget

try{

def JAG = new Jag2(log,vars,prev.getResponseDataAsString()); 
JAG.setSailContextAndUuid(); 



def support_dir = &quot;${vars.get(&quot;baseDirectory&quot;)}data${File.separator}supportingDocuments&quot;

//get all document file paths
def documents = Jag2.getFilePathsInFolder(support_dir)
//# of docs to upload
def docCountToUpload = 2//JAG.getRandomIntInRange(1,documents.size())
//Randomly select documents to upload and store in list
def targetPaths = JAG.getRandomItemsFromList(documents,docCountToUpload);



//Grab the first document, or return &quot;-1&quot; if list is empty 
def selectedDocument

if(!targetPaths.isEmpty()){
	
	//Grab the first document, or return &quot;-1&quot; if list is empty 
	selectedDocument = targetPaths.pop()

	def fuSupportingDocs = new MultipleFileUploadWidget(
		JAG.getObjectsByType(&quot;MultipleFileUploadWidget&quot;)?.find({it.label == &quot;Upload Supporting Attachments&quot;}),
		&quot;fuSupportingDocs&quot;
		).enterFilePath(selectedDocument)

	vars.putObject(&quot;fuSupportingDocs&quot;,fuSupportingDocs)
	JAG.saveSail([fuSupportingDocs])
	
}else{
	
	//remove fuSupportingDocs from the stack
	vars.putObject(&quot;fuSupportingDocs&quot;,null)
}
//List of further docs to upload
vars.putObject(&quot;remainingDocsToUpload&quot;,targetPaths);

	 
	
}catch(e){
	log.error(e.message);
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor -  decDuration, btnCreateMovie" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2
import jmeter.appian.groundswell.sailcontrols.MultipleFileUploadWidget

try{

def JAG = new Jag2(log,vars,prev.getResponseDataAsString()); 
JAG.setSailContextAndUuid(); 

//Dereference Picker to free up memory
vars.putObject(&quot;pwProducer&quot;,null)

def decDuration = JAG.createControl(
	JAG.getObjectByLabel(&quot;Duration (hours)&quot;),
	&quot;decDuration&quot;
).enterValue(1.5)

def btnCreateMovie = JAG.createControl(
	JAG.getObjectByLabel(&quot;Create Movie&quot;),
	&quot;btnCreateMovie&quot;
)


JAG.saveSail([decDuration,btnCreateMovie])

	 
	
}catch(e){
	log.error(e.message);
}
</stringProp>
