              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

try{

def JAG = new Jag2(log,vars,prev.getResponseDataAsString()); 

def interface_context = JAG.getSailContext()
def interface_uuid = JAG.getSailUUID()

vars.put(&quot;interface_context&quot;,interface_context); 
vars.put(&quot;interface_uuid&quot;, interface_uuid); 	 

//def updateRecordActionRefresh = JAG.getObjectByProperty(&quot;label&quot;,&quot;updateRecordActionRefresh&quot;)
//JAG.setSaveIntoAndCId(updateRecordActionRefresh,&quot;updateRecordActionRefresh&quot;)

def lnkUpdateRecordActionRefresh = JAG.createControl(
	JAG.getObjectByLabel(&quot;updateRecordActionRefresh&quot;),
	&quot;lnkUpdateRecordActionRefresh&quot;
)


JAG.saveSail([lnkUpdateRecordActionRefresh])






	
}catch(e){
	log.error(e.message);
}
</stringProp>
