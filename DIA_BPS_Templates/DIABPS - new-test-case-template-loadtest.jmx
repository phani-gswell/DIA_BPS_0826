              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - fuSupportingDocs - Next DOC" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2
import jmeter.appian.groundswell.sailcontrols.MultipleFileUploadWidget

try{

def JAG = new Jag2(log,vars,prev.getResponseDataAsString()); 
JAG.setSailContextAndUuid(); 

//Get the saved list of remaining document paths to upload
def targetPaths = vars.getObject(&quot;remainingDocsToUpload&quot;) as ArrayList

def selectedDocument

if(!targetPaths.isEmpty()){
	//Remove and use the first document path
	selectedDocument = targetPaths.pop()

	//Extract Supporting Docs MultipleFileUpload control and enter the acquired path
	def fuSupportingDocs = new MultipleFileUploadWidget(
		JAG.getObjectsByType(&quot;MultipleFileUploadWidget&quot;)?.find({it.label == &quot;Upload Supporting Attachments&quot;}),
		&quot;fuSupportingDocs&quot;
		).enterFilePath(selectedDocument)

	//We must save the Supporting Docs MultipleFileUploadWidget object for resuse for processing the file upload 
	//validation response
	vars.putObject(&quot;fuSupportingDocs&quot;,fuSupportingDocs)

	//Save the requisite sail properties 
	JAG.saveSail([fuSupportingDocs])
	
}else{
	//remove fuSupportingDocs from the stack
	vars.putObject(&quot;fuSupportingDocs&quot;,null)
}
//List of further docs to upload
vars.putObject(&quot;remainingDocsToUpload&quot;,targetPaths);


	 
	
}catch(e){
	log.error(e.message);
}
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
