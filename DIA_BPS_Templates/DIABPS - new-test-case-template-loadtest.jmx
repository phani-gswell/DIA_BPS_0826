	def JAG = new Jag2(log,vars,prev.getResponseDataAsString()); 
	JAG.setSailContextAndUuid(); 
	
	def pwProducer = vars.getObject(&quot;pwProducer&quot;)
	pwProducer.handlePickerResponse(JAG.data)

	JAG.saveSail(pwProducer)
	vars.putObject(&quot;pwProducer&quot;,pwProducer) 
	
}catch(e)
{
	log.error(&quot;Error:${e.message}&quot;); 
}</stringProp>
