                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.*
import com.jayway.jsonpath.JsonPath
import java.net.URLEncoder
import groovy.json.StringEscapeUtils

def slurp = new JsonSlurper();


try{

	//JSON SLURPER
	def responseText = prev.getResponseDataAsString();
	def response = slurp.parseText(responseText);

	def JAG = new Jag(log,vars,responseText); 
	
	 def lnkExpense = JAG.getObjectByProperty(&quot;label&quot;,&quot;Show Filters&quot;); 

	 log.info(&quot;lnkExpense:&quot;+ lnkExpense.toString());
	 
	//JsonPath
	def ctx = JsonPath.parse(responseText);
	def showFiltersBtn = ctx.read(&apos;$..[?(@.label==&quot;Show Filters&quot;)]&apos;);
	def context = ctx.read(&apos;$.context.value&apos;);
	def uuid = ctx.read(&apos;$.uuid&apos;);
	
     def showFiltersBtnName = &quot;showFiltersBtn&quot;
     
     def showFiltersBtnSaveInto =  showFiltersBtn.find().saveInto.first();
     // URLEncoder.encode(, &quot;UTF-8&quot;)
     
	vars.put(&quot;${showFiltersBtnName}_saveInto&quot;,StringEscapeUtils.escapeJava(showFiltersBtnSaveInto));
	vars.put(&quot;showFiltersBtn_cId&quot;,showFiltersBtn.find()._cId.toString());
	vars.put(&apos;context&apos;,StringEscapeUtils.escapeJava(context.toString())); 
	vars.put(&apos;uuid&apos;,uuid.toString()); 

//	log.info(&quot;saveInto: &quot;+StringEscapeUtils.escapeJava(showFiltersBtnSaveInto)); 
//	
//	log.info(&quot;response: &quot;+response._cId); 
//	log.info(&quot;uuid: &quot; + uuid); 
//	log.info(&quot;context: &quot; + context); 
//	log.info(&quot;showFiltersBtn: &quot; + URLEncoder.encode(showFiltersBtnSaveInto, &quot;UTF-8&quot;)); 
}catch(e){
	log.error(e.message);
}
</stringProp>
