            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - 20 - Get pmUuid and cacheKey">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 20 ******************************&quot;)

//************ Capture URL Context Query String - Method - 1 ******************//
/*
def jsonResponse = new JsonSlurper().parseText(prev.getResponseDataAsString())
log.info(&quot;20 - Json Response 1 -----&gt;&quot; + JsonOutput.toJson(jsonResponse))	
vars.put(&quot;urlContextQueryStringParam&quot;, jsonResponse.urlContextQueryString.toString())
log.info(&quot;20 - urlContextQueryStringValue is -----&gt;&quot; + vars.get(&quot;urlContextQueryStringValue&quot;))	
*/

//************ Capture URL Context Query String - Method - 2 Using JAG ******************//

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
 
try{

	//log.info(JsonOutput.prettyPrint(JsonOutput.toJson(JAG.data)));
   	def queryStringParam =  JAG.data.urlContextQueryString;
   	log.info(&quot;urlContextQueryString Parameter value is-----&gt;&quot;+ queryStringParam?.toString())
	vars.put(&quot;urlContextQueryStringParam&quot;, queryStringParam?.toString())   	
   	
	//************ Capture pm Uuid and Cache KeyCapture ******************//	
	
	def pmUuidcacheKeyParentJson = JAG.getObjectsByType(&quot;StartProcessLink&quot;).find()
	log.info(&quot;20 - PM Uuid and cache Key : Parent block -----&gt; &quot; + JsonOutput.toJson(pmUuidcacheKeyParentJson))	
	
	def pmUuidcacheKeySailControl = JAG.createControl(pmUuidcacheKeyParentJson, &quot;pmUuidcacheKey&quot;)
	JAG.saveSail(pmUuidcacheKeySailControl)
	
	log.info(&quot;20 - PM Uuid value is *****&gt; &quot; +  vars.get(&quot;pmUuidcacheKey_pmUuid&quot;))
	log.info(&quot;20 - PM cache Key  value is *****&gt; &quot; +  vars.get(&quot;pmUuidcacheKey_cacheKey&quot;))
	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)
}
catch(e){
	log.error(&quot;20 - Click Requirement Tab&quot; + e.message)
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
