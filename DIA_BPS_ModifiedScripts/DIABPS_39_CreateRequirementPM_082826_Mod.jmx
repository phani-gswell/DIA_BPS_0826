            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - 41 - Capture Context Value, Uuid, SaveInto, _cId" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 41 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;41 - Select Tag 1 Context value is ---- &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;41 - Select Tag 1 Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

try{

	//************ Get Save Into &amp; cId value for Select Tag 1 ******************//

	def selectTag1ParentJson = JAG.getObjectsByType(&quot;GridField&quot;).find()	
//	def selectTag1ParentJson1 = JAG.getObjectsByType(&quot;GridField&quot;).find({it?.requiredMessage == &quot;At least one item must be selected&quot; &amp;&amp; it?.hasNoValue == &quot;true&quot;})	// Other methods to capture
//	def selectTag1ParentJson1 = JAG.getObjectsByProperty(&quot;requiredMessage&quot;,&quot;At least one item must be selected&quot;).find()                                             // Other methods to capture
	log.info(&quot;41 - Select Tag 1 saveInto cId Parent Json -----&gt;&quot; + JsonOutput.toJson(selectTag1ParentJson))

	def selectTag1SailControl = JAG.createControl(selectTag1ParentJson, &quot;PP41_selectTag1saveIntocId&quot;)
	JAG.saveSail(selectTag1SailControl)
	log.info(&quot;41 - Select Tag 1 saveInto value is *****&gt;&quot; +  vars.get(&quot;PP41_selectTag1saveIntocId_saveInto&quot;))
	log.info(&quot;41 - Select Tag 1 cId value is *****&gt;&quot; +  vars.get(&quot;PP41_selectTag1saveIntocId_cId&quot;))	

}
catch(e){
	log.error(&quot;41 - Select Tag 1&quot; + e.message)
}</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
