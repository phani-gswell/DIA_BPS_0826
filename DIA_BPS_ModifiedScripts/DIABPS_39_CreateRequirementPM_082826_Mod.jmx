            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - 25 - Capture Context Value, Uuid, SaveInto, _cId" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 25 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;25 - Enter Requirement Description Context Id value is ---- &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;25 - Enter Requirement Description Id Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

try{

	//************ Get Save Into &amp; cId value for Enter description ******************//

	def enterDescParentJson = JAG.getObjectByLabel(&quot;Description&quot;)	
	log.info(&quot;25 - Enter Requirement Description saveInto Parent Json -----&gt;&quot; + JsonOutput.toJson(enterDescParentJson))
	
	def enterDescSailControl = JAG.createControl(enterDescParentJson, &quot;PP25_enterDescsaveIntocId&quot;)
	JAG.saveSail(enterDescSailControl)
	log.info(&quot;25 - Enter Requirement Description saveInto value is *****&gt;&quot; +  vars.get(&quot;PP25_enterDescsaveIntocId_saveInto&quot;))
	log.info(&quot;25 - Enter Requirement Description cId value is *****&gt;&quot; +  vars.get(&quot;PP25_enterDescsaveIntocId_cId&quot;))

	//************ Get Save Into &amp; cId value for Org Code Picker Widget ******************//

	def orgCodePickerWidgetParentJson = JAG.getObjectsByType(&quot;PickerWidget&quot;).find({it?.testLabel == &quot;test-Organization Code&quot; &amp;&amp; it?.hasNoValue == &quot;true&quot;})	
	log.info(&quot;25 - Org Code Picket Widget saveInto cId Parent Json -----&gt;&quot; + JsonOutput.toJson(orgCodePickerWidgetParentJson))
	
	def orgCodePickerWidgetSailControl = JAG.createControl(orgCodePickerWidgetParentJson, &quot;PP25_orgCodePicWidsaveIntocId&quot;)
	JAG.saveSail(orgCodePickerWidgetSailControl)
	log.info(&quot;25 - Org Code Picket Widget saveInto value is *****&gt;&quot; +  vars.get(&quot;PP25_orgCodePicWidsaveIntocId_saveInto&quot;))
	log.info(&quot;25 - Org Code Picket Widget cId value is *****&gt;&quot; +  vars.get(&quot;PP25_orgCodePicWidsaveIntocId_cId&quot;))	

}
catch(e){
	log.error(&quot;25 - Enter Requirement Title&quot; + e.message)
}	</stringProp>
            </JSR223PostProcessor>
