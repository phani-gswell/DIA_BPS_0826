            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - 23 - Capture Context Value, Uuid, _cId, SaveInto, Opaque Task Id" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 23 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;22 - Enter Title Context Id value is ----&gt; &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;22 - Enter Title Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

try{
	//************ Get Opaque Task Id ******************//

	def opaque_TaskId = JAG.getOpaqueTaskId()
	log.info(&quot;22 - Opaque Task Id -----&gt; &quot; + opaque_TaskId)	
	JAG.saveOpaqueTaskID(&quot;PP23_opaqueTaskId&quot;)
	log.info(&quot;22 - Opaque Task Id value is *****&gt;&quot; +  vars.get(&quot;PP23_opaqueTaskId&quot;))	

	//************ Get cId &amp; Save Into ******************//

//	def enterTitleParentJson = JAG.getObjectByProperty(&quot;label&quot;,&quot;Title&quot;)
//	log.info(&quot;23 - Title saveInto Parent Json 1 -----&gt; &quot; + JsonOutput.toJson(enterTitleParentJson))
	def enterTitleParentJson = JAG.getObjectByLabel(&quot;Title&quot;)	// Use getObjectByLabel for field with value instead of getObjectByProperty as above
	log.info(&quot;23 - Enter Title saveInto Parent Json 2 -----&gt; &quot; + JsonOutput.toJson(enterTitleParentJson))	

	def enterTitleSailControl = JAG.createControl(enterTitleParentJson, &quot;PP23_enterTitleValues&quot;)
	JAG.saveSail(enterTitleSailControl)
	log.info(&quot;23 - Enter Title saveInto value is *****&gt;&quot; +  vars.get(&quot;PP23_enterTitleValues_saveInto&quot;))
	log.info(&quot;23 - Enter Title cId value is *****&gt;&quot; +  vars.get(&quot;PP23_enterTitleValues_cId&quot;))

	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)
	
}
catch(e){
	log.error(&quot;23 - Click Create Requirement Button&quot; + e.message)
}</stringProp>
