            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - 21 - Get pmUuid and cacheKey" enabled="false">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 21 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());

try{
	
	def pmUuidcacheKeyParentJson = JAG.getObjectsByType(&quot;StartProcessLink&quot;).find()
	log.info(&quot;21 - PM Uuid and cache Key : Parent block -----&gt; &quot; + JsonOutput.toJson(pmUuidcacheKeyParentJson))	
	
	def pmUuidcacheKeySailControl = JAG.createControl(pmUuidcacheKeyParentJson, &quot;pmUuidcacheKey&quot;)
	JAG.saveSail(pmUuidcacheKeySailControl)
	
	log.info(&quot;21 - PM Uuid value is *****&gt; &quot; +  vars.get(&quot;pmUuidcacheKey_pmUuid&quot;))
	log.info(&quot;21 - PM cache Key  value is *****&gt; &quot; +  vars.get(&quot;pmUuidcacheKey_cacheKey&quot;))
	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)
}
catch(e){
	log.error(&quot;21 - Click Requirement Tab&quot; + e.message)
}
</stringProp>
