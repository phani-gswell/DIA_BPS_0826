            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - 145 - Get Requirement/Record Ref Id" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 145 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());

try{
	
//************ Get Record Ref Id ******************//

	def recordRefIdParentJson = JAG.getObjectsByType(&quot;RecordLink&quot;).find({it?.toString()?.contains(&quot;requirements&quot;)})
	log.info(&quot;Record Ref ID Parent block Json-----&gt; &quot; + JsonOutput.toJson(recordRefIdParentJson))

	def recordRefIdJson = new JsonSlurper().parseText(JsonOutput.toJson(recordRefIdParentJson))

	def recordRefIdValue = recordRefIdJson._recordRef
	log.info(&quot;Record Ref Id value is -----&gt;${recordRefIdValue}&lt;-----&quot;)
	vars.put(&quot;recordRefId&quot;, &quot;${recordRefIdValue}&quot;)
}
catch(e){
	log.error(&quot;Record Id extraction&quot; + e.message)
}</stringProp>
            </JSR223PostProcessor>
