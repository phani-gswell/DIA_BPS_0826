            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - 150 - Get Context Value, Uuid, _cId, SaveInto, Opaque Task Id">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 150 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;150 - Title Context Id value is ----&gt; &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;150 - Title Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

try{
	//************ Get Opaque Task Id ******************//

	def opaque_TaskId = JAG.getOpaqueTaskId()
	log.info(&quot;150 - Opaque Task Id -----&gt; &quot; + opaque_TaskId)	
	JAG.saveOpaqueTaskID(&quot;opaqueTaskId&quot;)
	log.info(&quot;150 - Opaque Task Id value is *****&gt;&quot; +  vars.get(&quot;opaqueTaskId&quot;))	

	//************ Get cId ******************//	
/*
	def modTitleCIdValue = JAG.getObjectsByProperty(&quot;#t&quot;, &quot;FormLayout&quot;).find().focusFieldId
	log.info(&quot;150 - Title cId Parent Json 2 -----&gt; &quot; + JsonOutput.toJson(modifyTitleParentJson))		
	log.info(&quot;150 - Title cId value -----&gt; &quot; + modTitleCIdValue)	
	vars.put(&quot;modTitlecId&quot;,modTitleCIdValue)
*/
	//************ Get cId &amp; Save Into ******************//

//	def modifyTitleParentJson = JAG.getObjectByProperty(&quot;label&quot;,&quot;Title&quot;)
//	log.info(&quot;150 - Title saveInto Parent Json 1 -----&gt; &quot; + JsonOutput.toJson(modifyTitleParentJson))
	def modifyTitleParentJson = JAG.getObjectByLabel(&quot;Title&quot;)	// Use getObjectByLabel for field with value instead of getObjectByProperty as above
	log.info(&quot;150 - Title saveInto Parent Json 2 -----&gt; &quot; + JsonOutput.toJson(modifyTitleParentJson))	

	def modifyTitleSailControl = JAG.createControl(modifyTitleParentJson, &quot;modifyTitleValues&quot;)
	JAG.saveSail(modifyTitleSailControl)
	log.info(&quot;150 - Title saveInto value is *****&gt;&quot; +  vars.get(&quot;modifyTitleValues_saveInto&quot;))
	log.info(&quot;150 - Title cId value is *****&gt;&quot; +  vars.get(&quot;modifyTitleValues_cId&quot;))
	
}
catch(e){
	log.error(&quot;Click Update Requirement Button-150 - Verify This Request&quot; + e.message)
}	</stringProp>
            </JSR223PostProcessor>
