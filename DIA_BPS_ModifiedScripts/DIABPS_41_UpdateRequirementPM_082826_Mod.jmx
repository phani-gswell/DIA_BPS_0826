              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 148 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.swapToHeader()

def reqIDSummaryJson = JAG.getData()
log.info(&quot;148 - Requirement View Summary Json -----&gt;&quot; + JsonOutput.toJson(reqIDSummaryJson))

try{


	//************ Get Action Dialog Id / Opaque Related Action Id ******************//	
/*
	def actionDialogParentJson = JAG.getObjectByProperty(&quot;name&quot;,&quot;x-embedded-header&quot;)
	log.info(&quot;Action Dialog / Opaque Related Action Id : Parent block 1 -----&gt; &quot; + JsonOutput.toJson(actionDialogParentJson))
	log.info(&quot;Action Dialog / Opaque Related Action Id : Parent block 2 -----&gt; &quot; + actionDialogParentJson)	

	def cleanedJsonString = JsonOutput.toJson(actionDialogParentJson).replace(&apos;\\\&quot;&apos;,&apos;&quot;&apos;)
	log.info(&quot;Unescaped Json value is  2------&quot; + cleanedJsonString)	
*/
/*
	String unescapeJson(String escapedJsonString) {
	    if (!(escapedJsonString instanceof String)) {
	        throw new IllegalArgumentException(&quot;Input must be a String&quot;)
	    }
	    try {
	        // Wrap in quotes if not already valid JSON string
	        String jsonWrapped = escapedJsonString.startsWith(&apos;&quot;&apos;) &amp;&amp; escapedJsonString.endsWith(&apos;&quot;&apos;)
	                ? escapedJsonString
	                : &quot;\&quot;${escapedJsonString}\&quot;&quot;
	
	        // Parse JSON string to unescape
	        def parsed = new JsonSlurper().parseText(jsonWrapped)
	        return parsed.toString()
	    } catch (Exception e) {
	        throw new RuntimeException(&quot;Invalid JSON string: ${e.message}&quot;, e)
	    }
	}

	log.info(&quot;Unescaped Json  : Parent block 5	 -----&gt;  ${unescapeJson(actionDialogParentJson)}&quot;)	
*/
	def opaqueRelatedActionIdJson = JAG.getObjectsByProperty(reqIDSummaryJson, &quot;#t&quot;, &quot;RelatedActionLink&quot;).find{it?.description ==&quot;Update this Requirement&quot;}.source
	log.info(&quot;148 - Opaque Related Action Id Json -----&gt; &quot; + JsonOutput.toJson(opaqueRelatedActionIdJson))

	def opaqueRelatedActionIdValue = opaqueRelatedActionIdJson.opaqueRelatedActionId 
	vars.put(&quot;opaqueRelated_ActionId&quot;, opaqueRelatedActionIdValue)
	log.info(&quot;148 - Opaque Related Action Id value is -----&gt;&quot; + opaqueRelatedActionIdValue)

}
catch(e){
	log.error(&quot;Click Requirement ID-148 - Req ID View Summary&quot; + e.message)
}

