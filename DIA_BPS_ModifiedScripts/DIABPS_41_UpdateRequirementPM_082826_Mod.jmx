              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 153 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;153 - Description Context Id value is ---- &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;153 - Description Id Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

try{

	//************ Get Save Into &amp; cId value ******************//

	def modifyDescParentJson = JAG.getObjectByLabel(&quot;Description&quot;)	// Use getObjectByLabel for field with value instead of getObjectByProperty as above
	log.info(&quot;153 - Description saveInto Parent Json -----&gt;&quot; + JsonOutput.toJson(modifyDescParentJson))
	
	def modifyDescSailControl = JAG.createControl(modifyDescParentJson, &quot;modifyDescsaveInto&quot;)
	JAG.saveSail(modifyDescSailControl)
	log.info(&quot;153 - Description saveInto value is *****&gt;&quot; +  vars.get(&quot;modifyDescsaveInto_saveInto&quot;))
	log.info(&quot;153 - Description cId value is *****&gt;&quot; +  vars.get(&quot;modifyDescsaveInto_cId&quot;))


}
catch(e){
	log.error(&quot;Modify Title -153 - Form&quot; + e.message)
}	</stringProp>
            </JSR223PostProcessor>
