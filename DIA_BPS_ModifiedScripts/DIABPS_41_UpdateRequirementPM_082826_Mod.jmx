              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 163 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;166 - Req Button Form Context Id value is ---- &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;166 - Req Button Form Id Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

try{
	
	//************ Get cId /Get Focus Field Id ******************//	
/*
	def focusFieldIdValue = JAG.getObjectsByProperty(&quot;#t&quot;, &quot;FormLayout&quot;).find().focusFieldId		
	log.info(&quot;150 - Focus Field Id value -----&gt; &quot; + focusFieldIdValue)	
	vars.put(&quot;focusFieldId&quot;,focusFieldIdValue)
*/



}
catch(e){
	log.error(&quot;All Tags cId &amp; saveInto extraction&quot; + e.message)
}	</stringProp>
            </JSR223PostProcessor>
