            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - 52 - Capture Context Value, Uuid, _cId, SaveInto" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 52 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;52 - Click Column Sort Ascend Data Context Id value is ----&gt; &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;52 - Click Column Sort Ascend Data Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

try{
	
	def sortAscendParentJson = JAG.getObjectsByProperty(&quot;#t&quot;, &quot;GridField&quot;).find()
	log.info(&quot;52 - Click Column Sort Ascend Data Parent Json 1 -----&gt; &quot; + JsonOutput.toJson(sortAscendParentJson))

	def sortAscendSailControl = JAG.createControl(sortAscendParentJson, &quot;PP52_sortAscendTags&quot;)
	JAG.saveSail(sortAscendSailControl)

	log.info(JsonOutput.prettyPrint(JsonOutput.toJson(sortAscendSailControl?.sailVariables)));		
	log.info(&quot;52 - Click Column Sort Ascend Data cId value is *****&gt;&quot; +  vars.get(&quot;PP52_sortAscendTags_cId&quot;))
	log.info(&quot;52 - Click Column Sort Ascend Data saveInto value is *****&gt;&quot; +  vars.get(&quot;PP52_sortAscendTags_saveInto&quot;))

	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)	
	
}
catch(e){
	log.error(&quot;Step 9_52 - PP52 - Capture Context Value, Uuid, _cId, SaveInto&quot; + e.message)
}</stringProp>
            </JSR223PostProcessor>
