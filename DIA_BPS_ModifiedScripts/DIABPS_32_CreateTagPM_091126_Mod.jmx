            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - 49 - Capture Context value and Uuid" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 49 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;49 - Enter Tag Description Context Id value is ----&gt; &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;49 - Enter Tag Description Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))


try{
	//************ Capture cId &amp; Save Into for Tag Description ******************// Use in Step 50

	def enterTagDescParentJson = JAG.getObjectByLabel(&quot;Description&quot;)	
	log.info(&quot;49 - Enter Tag saveInto Parent Json 2 -----&gt; &quot; + JsonOutput.toJson(enterTagDescParentJson))	

	def enterTagDescSailControl = JAG.createControl(enterTagDescParentJson, &quot;PP49_enterTagDescValues&quot;)
	JAG.saveSail(enterTagDescSailControl)
	log.info(JsonOutput.prettyPrint(JsonOutput.toJson(enterTagDescSailControl?.sailVariables)));			
	log.info(&quot;49 - Enter Tag saveInto value is *****&gt;&quot; +  vars.get(&quot;PP49_enterTagDescValues_saveInto&quot;))	
	log.info(&quot;49 - Enter Tag cId value is *****&gt;&quot; +  vars.get(&quot;PP49_enterTagDescValues_cId&quot;))


	//************ Get cId &amp; Save Into for Click Tag Button ******************// Use in Step 51
	
	def tagButtonParentJson = JAG.getObjectByProperty(&quot;action&quot;,&quot;SUBMIT&quot;)		
	log.info(&quot;49 - Click Tag Button saveInto Parent Json 2 -----&gt; &quot; + JsonOutput.toJson(tagButtonParentJson))	

	def tagButtonSailControl = JAG.createControl(tagButtonParentJson, &quot;PP49_tagButtonValues&quot;)
	JAG.saveSail(tagButtonSailControl)
	log.info(JsonOutput.prettyPrint(JsonOutput.toJson(tagButtonSailControl?.sailVariables)));			
	log.info(&quot;49 - Click Tag Button saveInto value is *****&gt;&quot; +  vars.get(&quot;PP49_tagButtonValues_saveInto&quot;))	
	log.info(&quot;49 - Click Tag Button value is *****&gt;&quot; +  vars.get(&quot;PP49_tagButtonValues_cId&quot;))	

	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)	
}
catch(e){
	log.error(&quot;Step 7_49 - PP49 - Capture Context value and Uuid&quot; + e.message)
}
	</stringProp>
            </JSR223PostProcessor>
