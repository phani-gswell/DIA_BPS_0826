              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - 39 - Capture Context Value and Uuid" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2
import groovy.json.JsonOutput

log.info(&quot;****************************** Post Processor 39 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

try{
	def PP27_orgCodePicker = vars.getObject(&quot;PP27_orgCodePicker_object&quot;);
	log.info(&quot;39 - Verify orgCodePicker Object was successfully loaded&quot;) 
	
	if(!PP27_orgCodePicker) log.info(&quot;orgCodePicker was not found&quot;);
	
	//log.info(&quot;PRE-HANDLE PICKER RESPONSE: \n&quot; + JsonOutput.prettyPrint(JsonOutput.toJson(PP27_orgCodePicker?.sailVariables)));
	PP27_orgCodePicker.handlePickerResponse(JAG.data); 
	
	log.info(&quot;39 - Available Suggestions: \n&quot; + JsonOutput.prettyPrint(JsonOutput.toJson(PP27_orgCodePicker?.getResponseSuggestions())));
	
	JAG.saveSail(PP27_orgCodePicker);  
	
	log.info(&quot;39 - POST-HANDLE PICKER RESPONSE: \n&quot; + JsonOutput.prettyPrint(JsonOutput.toJson(PP27_orgCodePicker?.sailVariables)));
	
	
	log.info(&quot;39 - Select Org Code Context Id value is ---- &quot; +  vars.get(&quot;context&quot;));
	log.info(&quot;39 - Select Org Code  Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;));
	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)
}
catch(e){	
	log.error(&quot;Step 7_39 - PP39 - Capture Context Value and Uuid&quot; + e.message)	
}
	</stringProp>
              </JSR223PostProcessor>
