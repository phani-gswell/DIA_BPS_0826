            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - 63 - Capture Context Value, Uuid, _cId, SaveInto" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 63 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;63 - Click Column Sort Ascend Data Context Id value is ----&gt; &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;63 - Click Column Sort Ascend Data Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

try{
	
	def allTagsParentJson = JAG.getObjectByLabel(&quot;All Tags&quot;)
	log.info(&quot;63 - Click All Tags Link Parent Json 1 -----&gt; &quot; + JsonOutput.toJson(allTagsParentJson))

	def allTagsSailControl = JAG.createControl(allTagsParentJson, &quot;PP63_allTags&quot;)
	JAG.saveSail(allTagsSailControl)

	log.info(JsonOutput.prettyPrint(JsonOutput.toJson(allTagsSailControl?.sailVariables)));		
	log.info(&quot;63 - Click All Tags Link Parent cId value is *****&gt;&quot; +  vars.get(&quot;PP63_allTags_cId&quot;))
	log.info(&quot;63 - Click All Tags Link Parent saveInto value is *****&gt;&quot; +  vars.get(&quot;PP63_allTags_saveInto&quot;))

	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)	
	
}
catch(e){
	log.error(&quot;Step 12_63 - PP63 - Capture Context Value, Uuid, _cId, SaveInto&quot; + e.message)
}</stringProp>
            </JSR223PostProcessor>
