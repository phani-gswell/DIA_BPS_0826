              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 23 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;23 - Click Create Tag Context Id value is ---- &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;23 - Click Create Tag  Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

vars.put(&quot;PP23_ContextValue&quot;, vars.get(&quot;context&quot;))   // Use this value in Step 52
vars.put(&quot;PP23_UUidValue&quot;, vars.get(&quot;uuid&quot;))         // Use this value in Step 52

try{

	//************ Capture pm Uuid and cacheKey ******************//

	def tagPMUuidCacheKeyParentJson = JAG.getObjectByLabel(&quot;Create Tag&quot;)	
	log.info(&quot;23 - Tag Parent Json 2 -----&gt; &quot; + JsonOutput.toJson(tagPMUuidCacheKeyParentJson))	

	def tagPMUuidCacheKeySailControl = JAG.createControl(tagPMUuidCacheKeyParentJson, &quot;PP23_tagPMUuidcacheKey&quot;)
	JAG.saveSail(tagPMUuidCacheKeySailControl)

	log.info(JsonOutput.prettyPrint(JsonOutput.toJson(tagPMUuidCacheKeySailControl?.sailVariables)));		
	log.info(&quot;23 - Tag pmUuid value is *****&gt;&quot; +  vars.get(&quot;PP23_tagPMUuidcacheKey_pmUuid&quot;))
	log.info(&quot;23 - Tag Cache Key value is *****&gt;&quot; +  vars.get(&quot;PP23_tagPMUuidcacheKey_cacheKey&quot;))

	//************ Capture cId and saveInto Dynamic Link ******************// 					For Step 52

	def tagBtnDynLinkParentJson = JAG.getObjectByLabel(&quot;updateRecordActionRefresh&quot;)	
	log.info(&quot;23 - Click Tag Button Dynamic Link Parent Json 2 -----&gt; &quot; + JsonOutput.toJson(tagBtnDynLinkParentJson))	

	def tagBtnDynLinkSailControl = JAG.createControl(tagBtnDynLinkParentJson, &quot;PP23_tagBtnDynLink&quot;)
	JAG.saveSail(tagBtnDynLinkSailControl)

	log.info(JsonOutput.prettyPrint(JsonOutput.toJson(tagBtnDynLinkSailControl?.sailVariables)));		
	log.info(&quot;23 - Tag Dynamic Link CId value is *****&gt;&quot; +  vars.get(&quot;PP23_tagBtnDynLink_cId&quot;))
	log.info(&quot;23 - Tag Dynamic Link saveInto value is *****&gt;&quot; +  vars.get(&quot;PP23_tagBtnDynLink_saveInto&quot;))


	//************ Capture cId and saveInto Start Processes Link ******************// 			For Step 52

	def tagBtnStrtProcessLinkParentJson1 = JAG.getObjectsByProperty(&quot;#t&quot;, &quot;StartProcessLink&quot;).find()
	log.info(&quot;23 - Click Tag Button Start Processes Link Parent Json 1 -----&gt; &quot; + JsonOutput.toJson(tagBtnStrtProcessLinkParentJson1))

	def tagBtnStrtProcessLinkSailControl = JAG.createControl(tagBtnStrtProcessLinkParentJson1, &quot;PP23_tabBtnStrtProcLink&quot;)
	JAG.saveSail(tagBtnStrtProcessLinkSailControl)

	log.info(JsonOutput.prettyPrint(JsonOutput.toJson(tagBtnStrtProcessLinkSailControl?.sailVariables)));		
	log.info(&quot;23 - Title cId value is *****&gt;&quot; +  vars.get(&quot;PP23_tabBtnStrtProcLink_cId&quot;))
	log.info(&quot;23 - Title saveInto value is *****&gt;&quot; +  vars.get(&quot;PP23_tabBtnStrtProcLink_saveInto&quot;))	

}
catch(e){
	log.error(&quot;Step 4_23 - PP23 - Extract pmUuid and cacheKey&quot; + e.message)
}</stringProp>
