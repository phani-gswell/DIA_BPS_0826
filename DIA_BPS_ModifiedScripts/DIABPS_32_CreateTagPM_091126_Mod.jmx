                <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2


log.info(&quot;****************************** Post Processor 21 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());

// Extracting Process/TaskId

try{

	//************ Capture Process/Task Id ******************//

//	def reportStubUrl1 = JAG.getObjectsByType(&quot;CardLayout&quot;).find({it?.toString()?.contains(&quot; TAGS&quot;)}).last
//	log.info(&quot;TaskId: Parent block 1 -----&gt; &quot; + JsonOutput.toJson(reportStubUrl1))

//	def reportStubUrl2 = JAG.getObjectsByType(&quot;CardLayout&quot;).find{it?.toString()?.contains(&quot; TAGS&quot;)}.last.link.reportUrlStub
//	def reportStubUrl2 = JAG.getObjectsByType(&quot;CardLayout&quot;).find{it?.toString()?.contains(&quot; TAGS&quot;)}.link.reportUrlStub
//	log.info(&quot;TaskId: Parent block 2 -----&gt; &quot; + JsonOutput.toJson(reportStubUrl2))	

	def reportStubUrlParentJson = JAG.getObjectsByType(&quot;CardLayout&quot;).find({it?.toString()?.contains(&quot; TAGS&quot;)})
	log.info(&quot;21 - TaskId: Parent block 1 -----&gt; &quot; + JsonOutput.toJson(reportStubUrlParentJson))	
	 
	def reportStubUrlTaskIdJson = JAG.getObjectsByProperty(reportStubUrlParentJson, &quot;#t&quot;, &quot;ReportLink&quot;).find()
	log.info(&quot;21 - TaskId: Parent block 2 -----&gt; &quot; + JsonOutput.toJson(reportStubUrlTaskIdJson))	
	
	def reportStubUrlTaskId = new JsonSlurper().parseText(JsonOutput.toJson(reportStubUrlTaskIdJson))
//	log.info(&quot;TaskId: Parent block 3 -----&gt; &quot; + reportStubUrlTaskId)

	def TaskId = reportStubUrlTaskId.reportUrlStub
	log.info(&quot;21 - Report TaskId value is *****&gt;${TaskId}&lt;*****&quot;)
	vars.put(&quot;PP21_Task_Id&quot;, &quot;${TaskId}&quot;)

	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)	
}
catch(e){
	log.error(&quot;Step 3_21 - PP21 - Capture Process / TaskId&quot; + e.message)
}	</stringProp>
