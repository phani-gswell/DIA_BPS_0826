            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - 27 - Capture Context Value, Uuid, _cId, SaveInto, Opaque Task Id" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 27 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;27 - Enter Tag Context Id value is ----&gt; &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;27 - Enter Tag Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

try{
	//************ Get Opaque Task Id ******************//

	def opaque_TaskId = JAG.getOpaqueTaskId()
	log.info(&quot;27 - Opaque Task Id -----&gt; &quot; + opaque_TaskId)	
	JAG.saveOpaqueTaskID(&quot;PP27_opaqueTaskId&quot;)
	log.info(&quot;27 - Opaque Task Id value is *****&gt;&quot; +  vars.get(&quot;PP27_opaqueTaskId&quot;))	

	//************ Get cId &amp; Save Into ******************//

//	def enterTagParentJson = JAG.getObjectByProperty(&quot;label&quot;,&quot;Tag&quot;)
//	log.info(&quot;27 - Tag saveInto Parent Json 1 -----&gt; &quot; + JsonOutput.toJson(enterTagParentJson))
	def enterTagParentJson = JAG.getObjectByLabel(&quot;Tag&quot;)	// Use getObjectByLabel for field with value instead of getObjectByProperty as above
	log.info(&quot;27 - Enter Tag saveInto Parent Json 2 -----&gt; &quot; + JsonOutput.toJson(enterTagParentJson))	

	def enterTagSailControl = JAG.createControl(enterTagParentJson, &quot;PP27_enterTagValues&quot;)
	JAG.saveSail(enterTagSailControl)
	log.info(JsonOutput.prettyPrint(JsonOutput.toJson(enterTagSailControl?.sailVariables)));			
	log.info(&quot;27 - Enter Tag saveInto value is *****&gt;&quot; +  vars.get(&quot;PP27_enterTagValues_saveInto&quot;))	
	log.info(&quot;27 - Enter Tag cId value is *****&gt;&quot; +  vars.get(&quot;PP27_enterTagValues_cId&quot;))


	//************ Get Save Into &amp; cId value for Org Code Picker Widget ******************//

	def orgCodePickerWidgetParentJson = JAG.getObjectsByType(&quot;PickerWidget&quot;).find({it?.testLabel == &quot;test-Organization&quot; &amp;&amp; it?.hasNoValue == &quot;true&quot;})	
	log.info(&quot;27 - Org Code Picket Widget saveInto cId Parent Json -----&gt;&quot; + JsonOutput.toJson(orgCodePickerWidgetParentJson))
	
	def orgCodePickerWidgetSailControl = JAG.createControl(orgCodePickerWidgetParentJson, &quot;PP27_orgCodePicker&quot;)
//	orgCodePickerWidgetSailControl.enterValue(&quot;JHTESTORG - JH_Test_Org&quot;);
//	orgCodePickerWidgetSailControl.enterValue(&quot;GSAPBS - Public Buildings Service&quot;);
	orgCodePickerWidgetSailControl.enterValue(&quot;${orgCodeSearchTerm}&quot;);

	JAG.saveSail(orgCodePickerWidgetSailControl);
	vars.putObject(&quot;PP27_orgCodePicker_object&quot;, orgCodePickerWidgetSailControl); 
	
	log.info(JsonOutput.prettyPrint(JsonOutput.toJson(orgCodePickerWidgetSailControl?.sailVariables)));		

	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)
	
}
catch(e){
	log.error(&quot;Step 5_27 - PP27 - Capture Context Value, Uuid, _cId, SaveInto, Opaque Task Id&quot; + e.message)
}</stringProp>
