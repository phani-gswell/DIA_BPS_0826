            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - Active Tags - Capture Context Value, UUID, cId, saveInto" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2
import java.net.URLEncoder

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;Active Tags Context Id value is ---- &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;Active Tags Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

// Extracting Active TAGS _cId and Content Value

try{
	
	
	// Extracting Active TAGS parent block 
	def activeTagsParentJson = JAG.getObjectsByType(&quot;CardLayout&quot;).find({it?.toString()?.contains(&quot;Active&quot;)})
	log.info(&quot;Active Tags: Parent block -----&gt; &quot; + JsonOutput.toJson(activeTagsParentJson))

	// Extracting Active TAGS cId &amp; saveInto block
	def activeTags_cId_saveIntoJson = JAG.getObjectsByProperty(activeTagsParentJson, &quot;#t&quot;, &quot;DynamicLink&quot;).find()
	log.info(&quot;Active Tags: cId &amp; saveInto block =====&gt; &quot; + JsonOutput.toJson(activeTags_cId_saveIntoJson))
	
	def activeTagsSailControl = JAG.createControl(activeTags_cId_saveIntoJson, &quot;activeTagscIdsaveInto&quot;)

	JAG.saveSail(activeTagsSailControl)

	log.info(&quot;Active Tags cId value is *****&gt; &quot; +  vars.get(&quot;activeTagscIdsaveInto_cId&quot;))
	log.info(&quot;Active Tags saveInto value is *****&gt; &quot; +  vars.get(&quot;activeTagscIdsaveInto_saveInto&quot;))	
	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)

}
catch(e){
	log.error(&quot;All Tags cId &amp; saveInto extraction&quot; + e.message)
}


</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
