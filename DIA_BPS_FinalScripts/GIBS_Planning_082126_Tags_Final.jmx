            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - All Tags - Capture Context Value, UUID, cId, saveInto" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2
import java.net.URLEncoder

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;All Tags Context Id value is ---- &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;All Tags Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

// Extracting ALL TAGS _cId and Content Value

try{
	
	
	// Extracting ALL TAGS parent block 
	def allTagsParentJson = JAG.getObjectsByType(&quot;CardLayout&quot;).find({it?.toString()?.contains(&quot;All Tags&quot;)})
	log.info(&quot;All Tags: Parent block -----&gt; &quot; + JsonOutput.toJson(allTagsParentJson))

	// Extracting ALL TAGS cId &amp; saveInto block
	def allTags_cId_saveIntoJson = JAG.getObjectsByProperty(allTagsParentJson, &quot;#t&quot;, &quot;DynamicLink&quot;).find()
	log.info(&quot;All Tags: cId &amp; saveInto block =====&gt; &quot; + JsonOutput.toJson(allTags_cId_saveIntoJson))
	
	def allTagsSailControl = JAG.createControl(allTags_cId_saveIntoJson, &quot;allTagscIdsaveInto&quot;)

	JAG.saveSail(allTagsSailControl)

	log.info(&quot;All Tags cId value is *****&gt; &quot; +  vars.get(&quot;allTagscIdsaveInto_cId&quot;))
	log.info(&quot;All Tags saveInto value is *****&gt; &quot; +  vars.get(&quot;allTagscIdsaveInto_saveInto&quot;))
	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)

}
catch(e){
	log.error(&quot;Click Tags&quot; + e.message)
}

</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
