              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2
import java.net.URLEncoder

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;Recently Created Tags Context Id value is ---- &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;Recently Created Tags Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

// Extracting Recently Created TAGS _cId and Content Value

try{
	
	
	// Extracting Recently Created TAGS parent block 
	def RecentlyTagsParentJson = JAG.getObjectsByType(&quot;CardLayout&quot;).find({it?.toString()?.contains(&quot;Recently Created&quot;)})
	log.info(&quot;Recently Created Tags: Parent block -----&gt; &quot; + JsonOutput.toJson(RecentlyTagsParentJson))

	// Extracting Recently Created TAGS cId &amp; saveInto block
	def RecentlyTags_cId_saveIntoJson = JAG.getObjectsByProperty(RecentlyTagsParentJson, &quot;#t&quot;, &quot;DynamicLink&quot;).find()
