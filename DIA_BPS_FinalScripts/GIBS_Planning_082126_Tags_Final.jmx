              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2
import java.net.URLEncoder

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;InActive Tags Context Id value is ---- &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;InActive Tags Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

// Extracting InActive TAGS _cId and Content Value

try{
	
	
	// Extracting InActive TAGS parent block 
	def InactiveTagsParentJson = JAG.getObjectsByType(&quot;CardLayout&quot;).find({it?.toString()?.contains(&quot;Inactive&quot;)})
	log.info(&quot;InActive Tags: Parent block -----&gt; &quot; + JsonOutput.toJson(InactiveTagsParentJson))

	// Extracting InActive TAGS cId &amp; saveInto block
	def InactiveTags_cId_saveIntoJson = JAG.getObjectsByProperty(InactiveTagsParentJson, &quot;#t&quot;, &quot;DynamicLink&quot;).find()
	log.info(&quot;InActive Tags: cId &amp; saveInto block =====&gt; &quot; + JsonOutput.toJson(InactiveTags_cId_saveIntoJson))
	
	def InactiveTagsSailControl = JAG.createControl(InactiveTags_cId_saveIntoJson, &quot;InactiveTagscIdsaveInto&quot;)

	JAG.saveSail(InactiveTagsSailControl)
	
	log.info(&quot;InActive Tags cId value is *****&gt; &quot; +  vars.get(&quot;InactiveTagscIdsaveInto_cId&quot;))
	log.info(&quot;InActive Tags saveInto value is *****&gt; &quot; +  vars.get(&quot;InactiveTagscIdsaveInto_saveInto&quot;))	
	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)

}
catch(e){
	log.error(&quot;Active Tag cId &amp; saveInto extraction&quot; + e.message)
}


