            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor - 26 - Modify Tag Name - Replace date time to the existing Title">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">String currentTagNameValue = &quot;${PP24_currentTagName}&quot;
log.info (&quot;The value of current Title value is -----&gt;&quot; + currentTagNameValue)

/*
String[] currentTagValues = currentTagNameValue.split(&quot;-&quot;)
log.info (&quot;The value of current Title first value is -----&gt;&quot; + currentTagValues[0])
log.info (&quot;The value of current Title second value is -----&gt;&quot; + currentTagValues[1])
def modifiedTagValue = currentTagValues[0] + &quot;-&quot; + &quot;${modDateTime}&quot;
vars.put(&quot;modifiedTag&quot;, modifiedTagValue)
*/
def modifiedTagNameValue = &quot;&quot;

if (currentTagNameValue.contains(&quot;-&quot;)){
	String[] currentTagNameValues = currentTagNameValue.split(&quot;-&quot;)
	log.info (&quot;The value of current Tag first value is -----&gt;&quot; + currentTagNameValues[0])
	log.info (&quot;The value of current Tag second value is -----&gt;&quot; + currentTagNameValues[1])
	modifiedTagNameValue = currentTagNameValues[0] + &quot;-&quot; + &quot;${modDateTime}&quot;
} else {
	modifiedTagNameValue = currentTagNameValue + &quot;-&quot; + &quot;${modDateTime}&quot;
}
vars.put(&quot;PreP26_modifiedTagName&quot;, modifiedTagNameValue)

</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - 26 - Capture Title Description, Context Value, Uuid, SaveInto, _cId">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 26 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;26 - Modify Tag Description Context Id value is ---- &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;26 - Modify Tag Description Id Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

try{

	//************ Get Save Into &amp; cId value for modify Tag description ******************//

	def modifyDescParentJson = JAG.getObjectByLabel(&quot;Description&quot;)	
	log.info(&quot;26 - Modify Tag Description saveInto Parent Json -----&gt;&quot; + JsonOutput.toJson(modifyDescParentJson))
	
	def modifyDescSailControl = JAG.createControl(modifyDescParentJson, &quot;PP26_modifyDesc&quot;)
	JAG.saveSail(modifyDescSailControl)

	log.info(&quot;SailVariables: &quot; + JsonOutput.prettyPrint(JsonOutput.toJson(modifyDescSailControl?.sailVariables)));	
	log.info(&quot;26 - Modify Tag Description saveInto value is *****&gt;&quot; +  vars.get(&quot;PP26_modifyDesc_saveInto&quot;))
	log.info(&quot;26 - Modify Tag Description cId value is *****&gt;&quot; +  vars.get(&quot;PP26_modifyDesc_cId&quot;))

	//************ Get Tag Description ******************//
	
	def currentTagDescValue = modifyDescParentJson.value
	vars.put(&quot;PP26_currentTagDescription&quot;, currentTagDescValue)
	log.info(&quot;26 - Current Description value is *****&gt;&quot; + currentTagDescValue)	

	//************ Get Save Into &amp; cId value for click update tag button******************//

	def updateTagButtonParentJson = JAG.getObjectsByLabel(&quot;Update Tag&quot;)find({it?.action == &quot;SUBMIT&quot;})
	log.info(&quot;26 - Update Tag saveInto Parent Json -----&gt;&quot; + JsonOutput.toJson(updateTagButtonParentJson))
	
	def updateTagButtonSailControl = JAG.createControl(updateTagButtonParentJson, &quot;PP26_updateTagButton&quot;)
	JAG.saveSail(updateTagButtonSailControl)

	log.info(&quot;SailVariables: &quot; + JsonOutput.prettyPrint(JsonOutput.toJson(updateTagButtonSailControl?.sailVariables)));	
	log.info(&quot;26 - Update Requirement saveInto value is *****&gt;&quot; +  vars.get(&quot;PP26_updateTagButton_saveInto&quot;))
	log.info(&quot;26 - Update Requirement cId value is *****&gt;&quot; +  vars.get(&quot;PP26_updateTagButton_cId&quot;))	

}
catch(e){
	log.error(&quot;Step 07_26 - PP26 - Capture Title Description, Context Value, Uuid, SaveInto, _cId&quot; + e.message)
}	</stringProp>
            </JSR223PostProcessor>
