                <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2


log.info(&quot;****************************** Post Processor 12 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());

// Extracting Process/TaskId

try{

	//************ Capture Process/Task Id ******************//

	def reportStubUrlParentJson = JAG.getObjectsByType(&quot;CardLayout&quot;).find({it?.toString()?.contains(&quot; TAGS&quot;)})
	log.info(&quot;TaskId: Parent block 1 -----&gt;&quot; + JsonOutput.toJson(reportStubUrlParentJson))	
	 
	def reportStubUrlTaskIdJson = JAG.getObjectsByProperty(reportStubUrlParentJson, &quot;#t&quot;, &quot;ReportLink&quot;).find()
	log.info(&quot;TaskId: Parent block 2 -----&gt;&quot; + JsonOutput.toJson(reportStubUrlTaskIdJson))	
	
	def reportUrlStubJson = new JsonSlurper().parseText(JsonOutput.toJson(reportStubUrlTaskIdJson))
//	log.info(&quot;TaskId: Parent block 3 -----&gt; &quot; + reportUrlStubJson)

	def reportUrlStubValue = reportUrlStubJson.reportUrlStub
	log.info(&quot;Report Url Stub value is *****&gt;${reportUrlStubValue}&lt;*****&quot;)
	vars.put(&quot;PP12_reportUrlStub&quot;, &quot;${reportUrlStubValue}&quot;)

	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)	
}
catch(e){
	log.error(&quot;Step 03_12 - PP12 - Capture Process / TaskId&quot; + e.message)
}</stringProp>
