            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - 17 - Capture opaqueRecordRef, opaqueRelatedActionId">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2
import groovy.json.JsonOutput

log.info(&quot;****************************** Post Processor 17 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;17 - Click Update Tag Button Context Id value is ----&gt; &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;17 - Click Update Tag Button Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))
vars.put(&quot;PP17_ContextValue&quot;, vars.get(&quot;context&quot;))   			// Use this value in Step-9, Request-29
vars.put(&quot;PP17_UuidValue&quot;, vars.get(&quot;uuid&quot;))         			// Use this value in Step-9, Request-29

try{

	def updateTagRALinkParentJson = JAG.getObjectsByLabel(&quot;Update Tag&quot;).find()	
	log.info(&quot;17 - Click View Details Tag Parent Json -----&gt; &quot; + JsonOutput.toJson(updateTagRALinkParentJson))

	//************ Get cId and saveInto for RelatedActionLink ******************//		Use this value in Step-9 Request-29

	def updateTagRelActLink_cId = updateTagRALinkParentJson._cId
	vars.put(&quot;PP17_updateTagRelActLink_cId&quot;, updateTagRelActLink_cId)
	log.info(&quot;17 - Update Tag Related Action Link cId value is -----&gt;&quot; + updateTagRelActLink_cId)

	def updateTagRelActLink_saveInto = JsonOutput.toJson(updateTagRALinkParentJson.onSubmitSaveInto[0])
	log.info(&quot;17 - Update Tag Related Action Link saveInto value is -----&gt;&quot; + updateTagRelActLink_saveInto)	
/*
	updateTagRelActLink_saveInto = updateTagRelActLink_saveInto
									.replace(&quot;\\&quot;,&quot;\\\\&quot;)
									.replace(&apos;&quot;&apos;,&apos;&apos;)
*/						
	updateTagRelActLink_saveInto = updateTagRelActLink_saveInto
									.replace(&apos;&quot;&apos;,&apos;&apos;)
	log.info(&quot;17 - Update Tag Related Action Link saveInto formated value is -----&gt;&quot; + updateTagRelActLink_saveInto)
	vars.put(&quot;PP17_updateTagRelActLink_saveInto&quot;, updateTagRelActLink_saveInto)

	//************ Get cId and saveInto for DynamicLink ******************//		Use this value in Step-9 Request-29

	def updateTagDLinkParentJson = JAG.getObjectsByLabel(&quot;updateRecordActionRefresh&quot;).find()	
	log.info(&quot;17 - Click Update Tag Button Dynamic Link Parent Json -----&gt;&quot; + JsonOutput.toJson(updateTagDLinkParentJson))

	def updateTagDLinkSailControl = JAG.createControl(updateTagDLinkParentJson, &quot;PP17_updateTagDynLink&quot;)
	JAG.saveSail(updateTagDLinkSailControl)

	log.info(JsonOutput.prettyPrint(JsonOutput.toJson(updateTagDLinkSailControl?.sailVariables)));		
	log.info(&quot;17 - Click Update Tag Button Dynamic Link cId value is *****&gt;&quot; +  vars.get(&quot;PP17_updateTagDynLink_cId&quot;))
	log.info(&quot;17 - Click Update Tag Button Dynamic Link saveInto value is *****&gt;&quot; +  vars.get(&quot;PP17_updateTagDynLink_saveInto&quot;))

	//************ Get Opaque Record Reference and Opaque Related Action Id ******************//	Use this value in Step-6 Request-23,24

	def updateTagOpaqueJson = JAG.getObjectsByProperty(updateTagRALinkParentJson,&quot;#t&quot;,&quot;InternalRelatedActionLink&quot;).find()
	log.info(&quot;17 - Click Update Tag Opaque Rec Ref &amp; Rel Action Id Json  -----&gt;&quot; + JsonOutput.toJson(updateTagOpaqueJson))

	def updateTag_opaqueRecordRef = updateTagOpaqueJson.opaqueRecordRef
	vars.put(&quot;PP17_updateTag_opaqueRecordRef&quot;, updateTag_opaqueRecordRef)
	log.info(&quot;17 - Opaque Record Ref value is -----&gt;&quot; + updateTag_opaqueRecordRef)

	def updateTag_opaqueRelatedActionId = updateTagOpaqueJson.opaqueRelatedActionId
	vars.put(&quot;PP17_updateTag_opaqueRelatedActionId&quot;, updateTag_opaqueRelatedActionId)
	log.info(&quot;17 - Opaque Related Action Id value is -----&gt;&quot; + updateTag_opaqueRelatedActionId)	
	
    log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)	
	
}
catch(e){
	log.error(&quot;Step 05_17 - PP17 - Capture opaqueRecordRef, opaqueRelatedActionId&quot; + e.message)
}
</stringProp>
