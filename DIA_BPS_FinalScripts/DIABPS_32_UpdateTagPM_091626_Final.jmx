            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - 24 - Capture Tag title, cId, saveInto, context and uuid">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 24 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;24 - Title Context Id value is ----&gt; &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;24 - Title Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

try{

	//************ Get Opaque Task Id ******************//

	def opaque_TaskId = JAG.getOpaqueTaskId()
	log.info(&quot;24 - Opaque Task Id -----&gt; &quot; + opaque_TaskId)	
	JAG.saveOpaqueTaskID(&quot;PP24_opaqueTaskId&quot;)
	log.info(&quot;24 - Opaque Task Id value is *****&gt;&quot; +  vars.get(&quot;PP24_opaqueTaskId&quot;))		

	//************ Get cId &amp; Save Into ******************//

	def modifyTagParentJson = JAG.getObjectsByType(&quot;TextField&quot;).find()	
	log.info(&quot;24 - Modify Tag Name Parent Json 1 -----&gt; &quot; + JsonOutput.toJson(modifyTagParentJson))

    def modifyTagSailControl = JAG.createControl(modifyTagParentJson, &quot;PP24_modifyTag&quot;)
    JAG.saveSail(modifyTagSailControl)

    log.info(&quot;SailVariables: &quot; + JsonOutput.prettyPrint(JsonOutput.toJson(modifyTagSailControl?.sailVariables)));

	//************ Get Tag Name ******************//    

	def currentTagNameValue = modifyTagParentJson.value
	vars.put(&quot;PP24_currentTagName&quot;, currentTagNameValue)
	log.info(&quot;24 - Current Tag Name is -----&gt;&quot; + currentTagNameValue)    

	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)	
	
}
catch(e){
	log.error(&quot;Step 06_24 - PP24 - Capture Tag title, cId, saveInto, context and uuid&quot; + e.message)
}</stringProp>
            </JSR223PostProcessor>
