              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 15 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;15 - Click View Details Tag Context Id value is ----&gt; &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;15 - Click View Details Tag Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

try{

	def viewTagDetailsParentJson = JAG.getObjectsByLabel(&quot;View Details&quot;).find()	
	log.info(&quot;15 - Click View Details Tag Parent Json 1 -----&gt; &quot; + JsonOutput.toJson(viewTagDetailsParentJson))
	def viewTagDetailsJson = JAG.getObjectsByProperty(viewTagDetailsParentJson,&quot;#t&quot;,&quot;DynamicLink&quot;).find()
	log.info(&quot;15 - Click View Details Tag Json 2 -----&gt; &quot; + JsonOutput.toJson(viewTagDetailsJson))

	def viewTagDetailsSailControl = JAG.createControl(viewTagDetailsJson, &quot;PP15_viewTagDetails&quot;)
	JAG.saveSail(viewTagDetailsSailControl)

	log.info(JsonOutput.prettyPrint(JsonOutput.toJson(viewTagDetailsSailControl?.sailVariables)));		
	log.info(&quot;15 - Click View Details Tag cId value is *****&gt;&quot; +  vars.get(&quot;PP15_viewTagDetails_cId&quot;))
	log.info(&quot;15 - Click View Details Tag saveInto value is *****&gt;&quot; +  vars.get(&quot;PP15_viewTagDetails_saveInto&quot;))

	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)	
	
}
catch(e){
	log.error(&quot;Step 04_15 - PP15 - Capture Context Value, Uuid, _cId, SaveInto&quot; + e.message)
}</stringProp>
