            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor -  30 - Capture Context Value, Uuid, _cId, SaveInto">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 30 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;30 - Click Update Tag Button Context Id value is ----&gt; &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;30 - Click Update Tag Button Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

try{

	def updateTagBtnParentJson = JAG.getObjectsByLabel(&quot;updateRecordActionRefresh&quot;).find()	
	log.info(&quot;30 - Click Update Tag Button Parent Json 1 -----&gt; &quot; + JsonOutput.toJson(updateTagBtnParentJson))

	def updateTagBtnSailControl = JAG.createControl(updateTagBtnParentJson, &quot;PP30_updateTagButton&quot;)
	JAG.saveSail(updateTagBtnSailControl)

	log.info(JsonOutput.prettyPrint(JsonOutput.toJson(updateTagBtnSailControl?.sailVariables)));		
	log.info(&quot;30 - Click Update Tag Button cId value is *****&gt;&quot; +  vars.get(&quot;PP30_updateTagButton_cId&quot;))
	log.info(&quot;30 - Click Update Tag Button saveInto value is *****&gt;&quot; +  vars.get(&quot;PP30_updateTagButton_saveInto&quot;))

	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)	
	
}
catch(e){
	log.error(&quot;Step 9_30 - PP30 - Capture Context Value, Uuid, _cId, SaveInto&quot; + e.message)
}</stringProp>
            </JSR223PostProcessor>
