            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor -  29 - Capture Context Value, Uuid, _cId, SaveInto">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import groovy.json.*
import jmeter.appian.groundswell.Jag2

log.info(&quot;****************************** Post Processor 29 ******************************&quot;)

def JAG = new Jag2(log,vars,prev.getResponseDataAsString());
JAG.setSailContextAndUuid();

log.info(&quot;29 - Click All Tags Context Id value is ----&gt; &quot; +  vars.get(&quot;context&quot;))
log.info(&quot;29 - Click All Tags Button Uuid value is --- &quot; +  vars.get(&quot;uuid&quot;))

try{

	def allTagsParentJson = JAG.getObjectsByLabel(&quot;All Tags&quot;).find()	
	log.info(&quot;29 - Click All Tags Parent Json 1 -----&gt; &quot; + JsonOutput.toJson(allTagsParentJson))

	def allTagsSailControl = JAG.createControl(allTagsParentJson, &quot;PP29_allTags&quot;)
	JAG.saveSail(allTagsSailControl)

	log.info(JsonOutput.prettyPrint(JsonOutput.toJson(allTagsSailControl?.sailVariables)));		
	log.info(&quot;29 - Click All Tags cId value is *****&gt;&quot; +  vars.get(&quot;PP29_allTags_cId&quot;))
	log.info(&quot;29 - Click All Tags saveInto value is *****&gt;&quot; +  vars.get(&quot;PP29_allTags_saveInto&quot;))

	log.info(&quot;-------------------------------------------------------------------------------------------------&quot;)	
	
}
catch(e){
	log.error(&quot;Step 9_29 - PP29 - Capture Context Value, Uuid, _cId, SaveInto&quot; + e.message)
}</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
